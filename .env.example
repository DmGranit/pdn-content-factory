# Шаблон настроек. Скопируй в .env (лежит рядом, в git НЕ попадает) и заполни своей рукой.
# Файл в UTF-8, читается Python-скриптами (cf_env.py). Пути с кириллицей здесь безопасны —
# в .bat их держать нельзя, консоль Windows их ломает.

# --- секреты ---
# Токен бота-публикатора (бот должен быть админом канала)
TELEGRAM_BOT_TOKEN=

# Канал для публикации
TELEGRAM_CHANNEL=@pdn152fz_check

# Ключ OpenAI — только для генерации картинок (publisher/make_image.py).
# Черновики без картинок собираются и без него.
OPENAI_API_KEY=

# --- необязательное ---
# Внешний секрет-брокер: путь к PowerShell-скрипту с командой `get <id>`.
# Если задан — токен и ключ берутся оттуда, а не из строк выше.
# CF_VAULT=

# Репозиторий лендинга: news_writer.py обновит в нём news.json.
# Коммит и push НЕ делает — это рука владельца. Не задано — лента просто не ведётся.
# CF_SITE_REPO=
